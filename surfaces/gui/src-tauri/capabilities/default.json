[
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capabilities for the main coworker window.",
    "windows": ["main"],
    "permissions": [
      "core:default",
      "core:window:allow-hide",
      "core:window:allow-show",
      "core:window:allow-set-focus",
      "core:window:allow-unminimize",
      "dialog:default",
      "opener:default",
      "autostart:default"
    ]
  },
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "companion-drag",
    "description": "Lets the floating Mimi companion start an OS window drag (position persistence happens Rust-side via WindowEvent::Moved, so the webview needs nothing else).",
    "windows": ["companion"],
    "permissions": ["core:window:allow-start-dragging"]
  }
]
